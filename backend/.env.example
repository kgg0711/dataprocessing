# 서버 포트
PORT=4000
# SQLite DB 파일 경로 (없으면 자동 생성 + 목업 데이터로 초기화)
DB_PATH=data/arti.db
# 데모 모드: 비밀번호 재설정 링크를 메일 대신 응답으로 돌려준다. 실제 운영에서는 false
DEMO_MODE=true
# 로그인 유지 기간(일)
SESSION_TTL_DAYS=14
# 프론트엔드를 다른 주소에서 띄울 때만 설정 (예: http://localhost:5173). Vite 프록시를 쓰면 비워 둔다
CORS_ORIGIN=
# Claude API 키를 넣으면 AI 질문/맞춤 설명이 Claude로 동작한다. 비워 두면 규칙 기반 답변으로 동작
ANTHROPIC_API_KEY=
# 사용할 Claude 모델
ARTI_AI_MODEL=claude-opus-5-5
